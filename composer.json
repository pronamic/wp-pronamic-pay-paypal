{
	"name": "wp-pay-gateways/paypal",
	"version": "2.4.0",
	"description": "PayPal driver for the WordPress payment processing library.",
	"keywords": [
		"wordpress",
		"wp",
		"pay",
		"paypal",
		"gateway",
		"pronamic"
	],
	"homepage": "http://www.wp-pay.org/gateways/paypal/",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "http://www.pronamic.eu/",
			"role": "Company"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@wp-pay.org",
		"issues": "https://github.com/wp-pay-gateways/paypal/issues",
		"source": "https://github.com/wp-pay-gateways/paypal"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\WordPress\\Pay\\Gateways\\PayPal\\": "src/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true,
			"roots/wordpress-core-installer": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"platform": {
			"php": "8.2"
		},
		"wp-slug": "pronamic-pay-paypal"
	},
	"require": {
		"php": ">=7.4",
		"ext-intl": "*",
		"ext-json": "*",
		"automattic/jetpack-autoloader": "^5.0",
		"justinrainbow/json-schema": "^6.8",
		"pronamic/wp-http": "^1.2",
		"pronamic/wp-money": "^2.4",
		"wp-pay/core": "^4.33"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.4",
		"overtrue/phplint": "^4.4",
		"php-coveralls/php-coveralls": "^2.5",
		"phpmd/phpmd": "^2.8",
		"phpstan/phpstan": "^1.11",
		"pronamic/pronamic-cli": "^1.1",
		"pronamic/wp-coding-standards": "^1.3",
		"roots/wordpress": "^6.0",
		"sirbrillig/phpcs-import-detection": "^1.2",
		"slevomat/coding-standard": "^6.4",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"vimeo/psalm": "^5.25",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-phpunit/wp-phpunit": "^6.1",
		"yoast/phpunit-polyfills": "^1.0"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/pronamic-pay-paypal/*",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-paypal/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-paypal/ --slug=pronamic-pay-paypal",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-paypal/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-paypal/ --plugin-dirname=pronamic-pay-paypal --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=pronamic-pay-paypal",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-paypal/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-paypal.pot"
		],
		"ci": [
			"@phplint",
			"@phpcs",
			"@coverage",
			"@phpstan",
			"@psalm"
		],
		"coveralls": "vendor/bin/php-coveralls -v",
		"phpcbf": "XDEBUG_MODE=off vendor/bin/phpcbf",
		"phpcs": "XDEBUG_MODE=off vendor/bin/phpcs -s -v",
		"phplint": "vendor/bin/phplint",
		"phpmd": "vendor/bin/phpmd src,tests text phpmd.ruleset.xml --suffixes php",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"phpunit": "vendor/bin/phpunit",
		"post-install-cmd": "echo 'Optionally run: composer bin all install'",
		"post-update-cmd": "echo 'Optionally run: composer bin all update'",
		"psalm": "vendor/bin/psalm",
		"xmllint-phpcs": "xmllint --noout --schema vendor/squizlabs/php_codesniffer/phpcs.xsd phpcs.xml.dist",
		"xmllint": [
			"@xmllint-phpcs"
		]
	}
}
